rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.uid == 'zE1LYEEyooedqV3YyGsTVJA3FcJ3'
          || request.auth.token.email in [
            'bafa@murathenes.org',
            'lorette.k@murathenes.org'
          ]
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isApprovedTrainer() {
      return signedIn()
        && get(/databases/$(database)/documents/trainers/$(request.auth.uid)).data.approvalStatus == 'approved';
    }

    function assignedTo(formationId) {
      return isApprovedTrainer()
        && request.auth.uid in get(/databases/$(database)/documents/formations/$(formationId)).data.trainerIds;
    }

    match /admins/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /trainers/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.accountUid == request.auth.uid
        && request.resource.data.approvalStatus == 'pending';
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && resource.data.approvalStatus == 'approved'
        && request.resource.data.approvalStatus == resource.data.approvalStatus
        && request.resource.data.accountUid == resource.data.accountUid
      );
      allow delete: if isAdmin();
    }

    // Team directory: names and email only, so trainers see who they work with without reading the full files.
    match /trainerProfiles/{userId} {
      allow read: if isAdmin() || isApprovedTrainer();
      allow create, update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'email', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /formations/{formationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Planning types (no dates, no trainers): admins only, trainers never see them.
    match /planningTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    // Meals of a stay (covers, menus, recipes): admins only.
    match /mealPlans/{planId} {
      allow read, write: if isAdmin();
    }

    match /formationPlans/{formationId} {
      allow read, write: if isAdmin() || assignedTo(formationId);

      // History of the plan: each version is the planning just before a change, written by whoever made that change.
      // Versions are never edited, so a lost time can always be found again.
      match /versions/{versionId} {
        allow read: if isAdmin() || assignedTo(formationId);
        allow create: if (isAdmin() || assignedTo(formationId))
          && request.resource.data.by == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    match /inscriptions/{inscriptionId} {
      allow read: if isAdmin() || assignedTo(resource.data.formationId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        assignedTo(resource.data.formationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'trainerNotes', 'traineeGroupNumber', 'starterNotes',
          'participationNotes', 'updatedAt'
        ])
      );
    }

    match /guideCategories/{documentId} {
      allow read: if isAdmin() || isApprovedTrainer();
      allow write: if isAdmin();
    }

    // Trainers may propose resources: they stay "pending" and belong to their author until an admin publishes them.
    match /guideResources/{documentId} {
      allow read: if isAdmin() || isApprovedTrainer();
      allow write: if isAdmin();
      allow create: if isApprovedTrainer()
        && request.resource.data.status == 'pending'
        && request.resource.data.proposedBy == request.auth.uid;
      allow update: if isApprovedTrainer()
        && resource.data.status == 'pending'
        && resource.data.proposedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.proposedBy == request.auth.uid;
      allow delete: if isApprovedTrainer()
        && resource.data.status in ['pending', 'rejected']
        && resource.data.proposedBy == request.auth.uid;
    }

    // Rubriques of the training times: renamed, reordered and added by admins.
    match /trainingCategories/{categoryId} {
      allow read: if isAdmin() || isApprovedTrainer();
      allow write: if isAdmin();
    }

    // Trainers' times are usable in their own plannings right away but join the guide only once an admin publishes them.
    match /trainingTimes/{documentId} {
      allow read: if isAdmin() || isApprovedTrainer();
      allow write: if isAdmin();
      allow create: if isApprovedTrainer()
        && request.resource.data.status == 'pending'
        && request.resource.data.proposedBy == request.auth.uid;
      allow update: if isApprovedTrainer()
        && resource.data.status in ['pending', 'rejected']
        && resource.data.proposedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.proposedBy == request.auth.uid;
      allow delete: if isApprovedTrainer()
        && resource.data.status in ['pending', 'rejected']
        && resource.data.proposedBy == request.auth.uid;
    }

    // Fallback file store when Storage is unavailable. Trainers can only add new files, never overwrite one.
    match /guideFiles/{fileId} {
      allow read: if true;
      allow write: if isAdmin();
      allow create: if isApprovedTrainer() && request.resource.data.size <= 20 * 1024 * 1024;

      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if isAdmin();
        allow create: if isApprovedTrainer();
      }
    }

    match /prospects/{prospectId} {
      allow create: if request.resource.data.keys().hasOnly([
          'origin', 'leadType', 'name', 'firstName', 'lastName', 'email',
          'phone', 'message', 'notes', 'pageUrl', 'source', 'callbackMoment',
          'department', 'quotient', 'formationId', 'formationTitle', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.origin in ['contact_form', 'aides_form']
        && request.resource.data.status == 'new'
        && request.resource.data.leadType is string
        && request.resource.data.leadType.size() <= 120
        && request.resource.data.formationId is string
        && request.resource.data.formationId.size() <= 120
        && request.resource.data.formationTitle is string
        && request.resource.data.formationTitle.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }
  }
}
